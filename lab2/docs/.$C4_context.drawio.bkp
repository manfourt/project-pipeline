<mxfile host="app.diagrams.net">
  <diagram id="c4ctx" name="C4 Context">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Контекстная диаграмма (C4, уровень 1): Data Pipeline качества воздуха&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="185" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;Open-Meteo Air Quality API&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;&lt;br&gt;Почасовые концентрации загрязнителей по координатам (модель CAMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;arcSize=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="lab1" value="&lt;b&gt;MinIO, bucket eco-data&lt;/b&gt;&lt;br&gt;[Внешняя система — лаб. работа 1]&lt;br&gt;&lt;br&gt;Датасет о загрязнении воздуха в городах России (Parquet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;arcSize=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="sys" value="&lt;b&gt;Data Pipeline качества воздуха&lt;/b&gt;&lt;br&gt;[Программная система, Python]&lt;br&gt;&lt;br&gt;Загружает данные через REST API, очищает и преобразует их, сохраняет в хранилище и строит аналитику" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="330" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="store" value="&lt;b&gt;MinIO, bucket air-quality&lt;/b&gt;&lt;br&gt;[Внешняя система — S3-хранилище]&lt;br&gt;&lt;br&gt;Зоны raw/, processed/, analytics/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;arcSize=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;Аналитик данных&lt;/b&gt;&lt;br&gt;[Пользователь]&lt;br&gt;&lt;br&gt;Оценивает экологическое состояние крупных городов России" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;arcSize=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="600" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="Запрашивает почасовые данные PM2.5, PM10, CO, NO2, SO2, O3 и US AQI за 2023–2024&lt;br&gt;[REST API, HTTPS, JSON]" style="endArrow=classic;html=1;dashed=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="api" target="sys">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="Забирает 20 крупнейших городов и их координаты&lt;br&gt;[S3 API, Parquet]" style="endArrow=classic;html=1;dashed=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="lab1" target="sys">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="Выгружает исходный JSON, обработанные данные и результаты анализа&lt;br&gt;[S3 API, JSON, Parquet]" style="endArrow=classic;html=1;dashed=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sys" target="store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="Получает рейтинг городов по загрязнению, динамику NO2 и SO2 по годам, сезонность PM2.5 и графики — для оценки качества воздуха&lt;br&gt;[Parquet, PNG]" style="endArrow=classic;html=1;dashed=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sys" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
